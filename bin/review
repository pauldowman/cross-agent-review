#!/usr/bin/env python3
"""Ask other AI agents to review this agent's work."""

import argparse
import contextlib
import os
import shlex
import signal
import subprocess
import sys
import time
from collections import namedtuple

KNOWN_AUTHORS = {
    "claude-opus-5": ("opus", "opus5"),
    "claude-sonnet-5": ("sonnet", "sonnet5"),
    "claude-fable-5": ("fable", "fable5"),
    "gpt-5.6": ("gpt", "gpt5", "codex"),
    "glm-5.2": ("glm", "glm5"),
}

PROMPT_PLACEHOLDER = "<prompt>"

Harness = namedtuple("Harness", "family argv")

HARNESS = {
    "claude-opus-5": Harness(
        "claude",
        (
            "claude",
            "-p",
            PROMPT_PLACEHOLDER,
            "--model",
            "claude-opus-5",
            "--permission-mode",
            "plan",
            "--output-format",
            "json",
        ),
    ),
}

REVIEWERS = {
    "gpt-5.6": ("claude-opus-5",),
    "glm-5.2": ("claude-opus-5",),
}

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_ALL_FAILED = 3
EXIT_RECURSION = 4

STATUS_OK = "ok"
STATUS_TIMEOUT = "timeout"
STATUS_HARNESS_MISSING = "harness_missing"

ACTIVE_ENV_VAR = "REVIEW_ACTIVE"
TIMEOUT_ENV_VAR = "REVIEW_TIMEOUT"
DEFAULT_TIMEOUT_SECONDS = 240
DRAIN_TIMEOUT_SECONDS = 5

ReviewerRun = namedtuple(
    "ReviewerRun",
    "reviewer family status text stderr duration_s returncode",
    defaults=(None,),
)


class ConfigurationError(Exception):
    """The environment asks for something this tool cannot honor."""


def build_alias_index(authors):
    """Map every canonical name and alias to its canonical name.

    Canonical names are registered first so an alias can never shadow one.
    Collisions are a bug in the hardcoded table and fail loudly.
    """
    index = {canonical: canonical for canonical in authors}
    for canonical, aliases in authors.items():
        for alias in aliases:
            if alias in index:
                raise ValueError(
                    f"author alias {alias!r} collides with {index[alias]!r}"
                )
            index[alias] = canonical
    return index


AUTHOR_ALIASES = build_alias_index(KNOWN_AUTHORS)


def resolve_author(name):
    """Return the canonical author name for a name or alias, or None."""
    return AUTHOR_ALIASES.get(name.strip().lower())


def format_known_authors():
    lines = ["Known authors:"]
    for canonical, aliases in KNOWN_AUTHORS.items():
        lines.append(f"  {canonical} ({', '.join(aliases)})")
    return "\n".join(lines)


def build_prompt(description, cwd):
    return f"""You are reviewing work produced by another AI coding agent.

Working directory: {cwd}
The author asked you to review: {description}

Resolve that description against the repository yourself. It may name a branch, \
the uncommitted changes, or a path to a file. Inspect the actual work with git \
commands and by reading files -- do not rely on the description alone.

Do not modify, create, or delete any files. This is a read-only review.

Report what is wrong, what is risky, and what should change before this ships."""


def resolve_argv(reviewer, prompt):
    template = HARNESS[reviewer].argv
    placeholders = [part for part in template if part == PROMPT_PLACEHOLDER]
    if len(placeholders) != 1:
        raise ValueError(
            f"harness template for {reviewer!r} needs exactly one "
            f"{PROMPT_PLACEHOLDER}, found {len(placeholders)}"
        )
    return [prompt if part == PROMPT_PLACEHOLDER else part for part in template]


def reviewer_timeout():
    """Seconds to allow one reviewer, from the environment.

    Unset or empty means the default. Anything else must be a positive whole
    number: a bad value would otherwise time every reviewer out instantly.
    """
    raw = os.environ.get(TIMEOUT_ENV_VAR)
    if not raw:
        return DEFAULT_TIMEOUT_SECONDS
    try:
        seconds = int(raw)
    except ValueError:
        raise ConfigurationError(
            f"{TIMEOUT_ENV_VAR} must be a whole number of seconds, got {raw!r}"
        )
    if seconds <= 0:
        raise ConfigurationError(
            f"{TIMEOUT_ENV_VAR} must be greater than zero, got {seconds}"
        )
    return seconds


def child_environment():
    environment = os.environ.copy()
    environment[ACTIVE_ENV_VAR] = "1"
    return environment


def run_reviewer(reviewer, prompt, timeout=None):
    """Run one reviewer to completion, killing its whole process group on timeout."""
    family = HARNESS[reviewer].family
    argv = resolve_argv(reviewer, prompt)
    timeout = reviewer_timeout() if timeout is None else timeout
    started = time.monotonic()

    def finished(status, text, stderr, returncode=None):
        return ReviewerRun(
            reviewer=reviewer,
            family=family,
            status=status,
            text=text,
            stderr=stderr,
            duration_s=time.monotonic() - started,
            returncode=returncode,
        )

    try:
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=child_environment(),
            start_new_session=True,
        )
    except OSError as error:
        return finished(STATUS_HARNESS_MISSING, "", f"{argv[0]}: {error.strerror}")

    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_process_group(process)
        stdout, stderr = drain(process)
        notice = f"timed out after {timeout}s"
        return finished(
            STATUS_TIMEOUT, stdout, f"{notice}\n{stderr}" if stderr else notice
        )

    return finished(STATUS_OK, stdout, stderr, process.returncode)


def drain(process):
    """Collect whatever a killed process left behind, without waiting forever.

    A descendant that started its own session survives the group kill and
    holds the output pipes open, so this must not block indefinitely.
    """
    try:
        return process.communicate(timeout=DRAIN_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        for pipe in (process.stdout, process.stderr):
            if pipe is not None:
                pipe.close()
        with contextlib.suppress(subprocess.TimeoutExpired):
            process.wait(timeout=DRAIN_TIMEOUT_SECONDS)
        return "", ""


def kill_process_group(process):
    """Kill the subprocess and everything it spawned.

    The child leads its own session, so its descendants share its process
    group; killing the leader alone would leave them running.
    """
    try:
        os.killpg(os.getpgid(process.pid), signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        process.kill()


def build_parser():
    parser = argparse.ArgumentParser(
        prog="review",
        description="Ask other AI agents to review your work.",
    )
    parser.add_argument("author", nargs="?", help="the AI model that produced the work")
    parser.add_argument(
        "description",
        nargs="?",
        help="what to review, e.g. 'the uncommitted changes' or 'agent-planning/01-review-tool.md'",
    )
    parser.add_argument(
        "--known-authors",
        action="store_true",
        help="list recognized author names and exit",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the command each reviewer would run, without running them",
    )
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.known_authors:
        print(format_known_authors())
        return EXIT_OK

    if os.environ.get(ACTIVE_ENV_VAR):
        print(
            "review: refusing to run inside a review; a reviewer must not "
            "call `review` itself.",
            file=sys.stderr,
        )
        return EXIT_RECURSION

    if not args.author or not args.description:
        parser.error("author and description are both required")

    author = resolve_author(args.author)
    if author is None:
        print(
            f"review: unknown author {args.author!r}\n"
            "Run `review --known-authors` to see the list.",
            file=sys.stderr,
        )
        return EXIT_USAGE

    reviewers = REVIEWERS.get(author, ())
    if not reviewers:
        print(f"review: no reviewers are configured for {author}", file=sys.stderr)
        return EXIT_USAGE

    try:
        timeout = reviewer_timeout()
    except ConfigurationError as error:
        print(f"review: {error}", file=sys.stderr)
        return EXIT_USAGE

    prompt = build_prompt(args.description, os.getcwd())

    if args.dry_run:
        for reviewer in reviewers:
            print(f"{reviewer}: {shlex.join(resolve_argv(reviewer, prompt))}")
        return EXIT_OK

    run = run_reviewer(reviewers[0], prompt, timeout=timeout)
    if run.status != STATUS_OK:
        print(f"review: {run.reviewer} failed ({run.status})", file=sys.stderr)
        if run.stderr:
            print(run.stderr, file=sys.stderr)
        return EXIT_ALL_FAILED

    print(run.text, end="")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
